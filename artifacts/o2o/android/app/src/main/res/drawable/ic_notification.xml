<?xml version="1.0" encoding="utf-8"?>
<!--
  FCM / Android notification small icon.

  Rules for Android notification icons (API 21+):
    - Must be white-on-transparent (all non-transparent pixels are treated
      as white by the system; colour is added via the notification channel
      accent or per-notification color field).
    - Designed for the 24 x 24 dp "notification icon" slot in the status bar.
    - MUST NOT use colour gradients or coloured pixels — they will be
      rendered as solid grey on Android 5+.

  This is a simplified "O2O" chat/connection icon:
    • Two overlapping circles (representing two people/parties)
    • A connecting arrow between them
  This matches the O2O brand concept (one-to-one) and is clearly legible
  at 24 dp in the status bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- Left person / circle -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M7,7 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0" />
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M7,13 C4.24,13 1,14.34 1,16 L1,17 L13,17 L13,16 C13,14.34 9.76,13 7,13 Z" />

  <!-- Right person / circle -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M17,7 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0" />
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M17,13 C14.24,13 11,14.34 11,16 L11,17 L23,17 L23,16 C23,14.34 19.76,13 17,13 Z" />

  <!-- Connecting arrow — vertical indicator between the two people -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M12,10 L12,21 M9,19 L12,22 L15,19"
      android:strokeWidth="1.5"
      android:strokeColor="#FFFFFF"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />

</vector>
